# Local environment (never committed; template: .env.example)
.env
mise.local.toml

# .NET
backend/**/bin/
backend/**/obj/
*.user
*.suo
.vs/

# Frontend
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
.venv/

# ETL data: outside Git except manifests in data/sources/
data/raw/*
data/processed/*
data/normalized/*
!data/**/.gitkeep

# Runtime outbox (FakeEmailSender): confirmation emails contain tokens
data/outbox/

# Divers
docs/
*.log
.DS_Store
Thumbs.db

# Profils Chrome créés par un outil avec un chemin Windows (noms contenant `C:\`)
C\:\\Users*

# Répertoires de compétences d'agents
.agents/
.claude/
.qoder/
.rovodev/
.trae/
# intellij
.idea
