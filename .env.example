POSTGRES_DB=explorer
POSTGRES_USER=explorer
POSTGRES_PASSWORD=

# --- Base de données : distante (primaire) ou Docker (repli) ---
# local  = toujours le service db de docker-compose.yml
# remote = toujours la base distante (échec explicite si elle ne répond pas)
# auto   = distante si elle répond et propose PostGIS + PostGIS raster, sinon repli Docker
DATABASE_TARGET=local
REMOTE_DB_HOST=
REMOTE_DB_PORT=5432
REMOTE_DB_NAME=
REMOTE_DB_USER=
REMOTE_DB_PASSWORD=

# Connexion utilisée par `dotnet run` hors conteneur (Host=localhost).
# Dans les conteneurs, compose définit sa propre chaîne avec Host=db.
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=explorer;Username=explorer;Password=
# Version des données chargées par l'ETL (affichée sur /api/v1/health)
DATA_VERSION=

AI_ENABLED=false
AI_PROVIDER=fake
# URL du serveur CLEF hébergé sur une autre instance (obligatoire si AI_ENABLED=true), par exemple https://<hôte>:8080
AI_ENDPOINT=
# Authentification HTTP Basic du serveur CLEF (laisser vide si le serveur n'en demande pas) ; ne jamais versionner
AI_USERNAME=
AI_PASSWORD=
AI_MODEL=clef-flash
AI_TIMEOUT_SECONDS=10

ISOCHRONE_PROVIDER=fake
ISOCHRONE_API_KEY=
ISOCHRONE_DAILY_BUDGET=1000

# Frontend (lu depuis la racine par Vite, envDir: "..")
# Vide = URLs relatives ; en développement, Vite proxifie /api vers 127.0.0.1:5080
VITE_API_URL=
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_BASEMAP_DARK_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# API TÜİK (SDMX) : clé personnelle générée sur veriportali.tuik.gov.tr ; ne jamais la versionner
# Le jeton obtenu avec cette clé ne dure que 5 minutes ; l'ETL le renouvelle lui-même
TUIK_API_KEY=
