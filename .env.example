# Copier vers .env (jamais commité) : cp .env.example .env

# --- PostgreSQL (service db de docker-compose.yml) ---
POSTGRES_DB=explorer
POSTGRES_USER=explorer
POSTGRES_PASSWORD=change_me_local_only

# --- API ---
# Local (dotnet run) : Host=localhost ; dans les conteneurs, compose définit
# DATABASE_CONNECTION_STRING avec Host=db à partir des variables POSTGRES_*.
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=explorer;Username=explorer;Password=change_me_local_only
# Version des données chargées par l'ETL (affichée sur /api/v1/health)
DATA_VERSION=

# --- IA optionnelle (désactivée par défaut : l'app fonctionne sans IA ni GPU) ---
AI_ENABLED=false
AI_PROVIDER=fake
AI_ENDPOINT=http://clef:8080
AI_MODEL=clef-flash
AI_TIMEOUT_SECONDS=10

# --- Isochrones (factices par défaut) ---
ISOCHRONE_PROVIDER=fake
ISOCHRONE_API_KEY=
ISOCHRONE_DAILY_BUDGET=1000

# --- CLEF (profil "ai", optionnel) ---
# Scripts benchmarks/clef : smoke-test.py et preferences-probe.py
CLEF_URL=http://localhost:8090/v1/systemone
CLEF_QUANT=Q4_K_M
# Commit de llama.cpp à épingler (vide = référence pull/29831/head, mouvante)
CLEF_LLAMA_COMMIT=
CLEF_MEMORY_LIMIT=12g

# --- Frontend ---
# Fond de carte OpenFreeMap (Positron par défaut)
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
