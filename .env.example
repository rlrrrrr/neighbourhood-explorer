POSTGRES_DB=explorer
POSTGRES_USER=explorer
POSTGRES_PASSWORD=

# --- Database: remote (primary) or Docker (fallback) ---
# local  = toujours le service db de docker-compose.yml
# remote = always the remote database (explicit failure if it is unavailable)
# auto   = remote if it responds and provides PostGIS + PostGIS raster, otherwise Docker fallback
DATABASE_TARGET=local
REMOTE_DB_HOST=
REMOTE_DB_PORT=5432
REMOTE_DB_NAME=
REMOTE_DB_USER=
REMOTE_DB_PASSWORD=

# Connection used by `dotnet run` outside a container.
# Match it to DATABASE_TARGET: remote values here, or Host=localhost for the Compose db.
# In containers, Compose defines its own connection string with Host=db.
# Single quotes are required: bash splits an unquoted value at the first ';'.
DATABASE_CONNECTION_STRING='Host=localhost;Port=5432;Database=explorer;Username=explorer;Password='
# Accounts receiving the `admin` role at startup and when they register (comma-separated)
ADMIN_EMAILS=
# Version of the data loaded by the ETL (shown by /api/v1/health)
DATA_VERSION=

# Base URL of the frontend, used to build the email-confirmation link
FRONTEND_BASE_URL=http://localhost:5173
# Development emails (FakeEmailSender); empty = data/outbox at the repository root
EMAIL_OUTBOX_PATH=

AI_ENABLED=false
AI_PROVIDER=fake
# URL of the CLEF server hosted on another instance (required when AI_ENABLED=true), for example https://<host>:8080
AI_ENDPOINT=
# CLEF server HTTP Basic authentication (leave empty if not required); never commit it
AI_USERNAME=
AI_PASSWORD=
AI_MODEL=clef-flash
AI_TIMEOUT_SECONDS=10

ISOCHRONE_PROVIDER=fake
ISOCHRONE_API_KEY=
ISOCHRONE_DAILY_BUDGET=1000

# Frontend (lu depuis la racine par Vite, envDir: "..")
# Empty = relative URLs; in development, Vite proxies /api to 127.0.0.1:5080
VITE_API_URL=
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_BASEMAP_DARK_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# TÜİK API (SDMX): personal key generated at veriportali.tuik.gov.tr; never commit it
# The token obtained with this key lasts only 5 minutes; the ETL renews it automatically
TUIK_API_KEY=
