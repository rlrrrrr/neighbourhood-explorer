{
  "openapi": "3.1.0",
  "info": {
    "title": "Neighbourhood Explorer API",
    "version": "1.0.0",
    "description": "Contrat d'API versionné (source de vérité). Le frontend génère ses types depuis ce fichier."
  },
  "servers": [
    { "url": "http://localhost:5080", "description": "API locale (dotnet run)" },
    { "url": "http://localhost:5080", "description": "API conteneurisée (docker compose, port hôte 5080)" }
  ],
  "paths": {
    "/api/v1/cities": {
      "get": {
        "operationId": "getCities",
        "summary": "Villes disponibles",
        "responses": {
          "200": {
            "description": "Provinces disponibles, triées par code officiel",
            "headers": {
              "ETag": {
                "description": "Empreinte du contenu, utilisable avec If-None-Match",
                "schema": { "type": "string" }
              },
              "Cache-Control": {
                "description": "Durée de mise en cache côté client",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CitiesResponse" }
              }
            }
          },
          "503": {
            "description": "Base de données non configurée ou non joignable",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    },
    "/api/v1/cities/{cityId}/neighborhoods": {
      "get": {
        "operationId": "getCityNeighborhoods",
        "summary": "Géométries simplifiées des quartiers d'une ville (GeoJSON)",
        "parameters": [
          {
            "name": "cityId",
            "in": "path",
            "required": true,
            "description": "Code de province (34 = İstanbul), résolu via official_code = TR-{cityId}",
            "schema": { "type": "integer", "format": "int32" }
          }
        ],
        "responses": {
          "200": {
            "description": "FeatureCollection GeoJSON ; chaque géométrie est simplifiée pour l'affichage (COALESCE(display_geometry, geometry))",
            "headers": {
              "ETag": {
                "description": "Empreinte du contenu, utilisable avec If-None-Match",
                "schema": { "type": "string" }
              },
              "Cache-Control": {
                "description": "Durée de mise en cache côté client",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/geo+json": {
                "schema": { "$ref": "#/components/schemas/NeighborhoodFeatureCollection" }
              }
            }
          },
          "404": {
            "description": "Ville inconnue",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "503": {
            "description": "Base de données non configurée ou non joignable",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    },
    "/api/v1/neighborhoods/{id}": {
      "get": {
        "operationId": "getNeighborhood",
        "summary": "Détail d'un quartier : hiérarchie, géométrie complète et centroïde",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identifiant interne du quartier (admin_area.id)",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Quartier trouvé",
            "headers": {
              "ETag": {
                "description": "Empreinte du contenu, utilisable avec If-None-Match",
                "schema": { "type": "string" }
              },
              "Cache-Control": {
                "description": "Durée de mise en cache côté client",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NeighborhoodDetail" }
              }
            }
          },
          "404": {
            "description": "Quartier inconnu",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "503": {
            "description": "Base de données non configurée ou non joignable",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    },
    "/api/v1/neighborhoods/{id}/metrics": {
      "get": {
        "operationId": "getNeighborhoodMetrics",
        "summary": "Toutes les métriques d'un quartier, avec leur date d'observation et leur source",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identifiant interne du quartier (admin_area.id)",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Valeurs les plus récentes du quartier, triées par clé de métrique",
            "headers": {
              "ETag": {
                "description": "Empreinte du contenu, utilisable avec If-None-Match",
                "schema": { "type": "string" }
              },
              "Cache-Control": {
                "description": "Durée de mise en cache côté client",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NeighborhoodMetrics" }
              }
            }
          },
          "404": {
            "description": "Quartier inconnu",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "503": {
            "description": "Base de données non configurée ou non joignable",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Santé du service : base, version des données, état de l'IA",
        "responses": {
          "200": {
            "description": "État courant du service",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/metrics": {
      "get": {
        "operationId": "getMetrics",
        "summary": "Définitions des métriques avec leur source, leurs traductions et la date de la dernière observation",
        "responses": {
          "200": {
            "description": "Définitions des métriques disponibles",
            "headers": {
              "ETag": {
                "description": "Empreinte du contenu, utilisable avec If-None-Match",
                "schema": { "type": "string" }
              },
              "Cache-Control": {
                "description": "Durée de mise en cache côté client",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MetricsResponse" }
              }
            }
          },
          "503": {
            "description": "Base de données non configurée ou non joignable",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    },
    "/api/v1/cities/{cityId}/metric-values": {
      "get": {
        "operationId": "getCityMetricValues",
        "summary": "Dernières valeurs des métriques demandées pour les quartiers d'une ville",
        "parameters": [
          {
            "name": "cityId",
            "in": "path",
            "required": true,
            "description": "Code de province (34 = İstanbul), résolu via official_code = TR-{cityId}",
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "metrics",
            "in": "query",
            "required": true,
            "description": "Clés de métriques séparées par des virgules (ex. population_density)",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Valeurs brutes et normalisées, indexées par clé de métrique puis par identifiant de quartier",
            "headers": {
              "ETag": {
                "description": "Empreinte du contenu, utilisable avec If-None-Match",
                "schema": { "type": "string" }
              },
              "Cache-Control": {
                "description": "Durée de mise en cache côté client",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MetricValues" }
              }
            }
          },
          "400": {
            "description": "Paramètre metrics absent ou clé de métrique inconnue",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "404": {
            "description": "Ville inconnue",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "503": {
            "description": "Base de données non configurée ou non joignable",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["database", "ai"],
        "properties": {
          "database": {
            "type": "string",
            "enum": ["ok", "unavailable"],
            "description": "État de la base PostgreSQL/PostGIS"
          },
          "dataVersion": {
            "type": ["string", "null"],
            "description": "Version des données chargées par l'ETL, null tant que rien n'est chargé"
          },
          "ai": {
            "type": "string",
            "enum": ["disabled", "warming", "ready", "unavailable"],
            "description": "État du modèle de décision (disabled quand AI_ENABLED est désactivé)"
          }
        }
      },
      "CitiesResponse": {
        "type": "object",
        "required": ["cities"],
        "properties": {
          "cities": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/City" }
          }
        }
      },
      "City": {
        "type": "object",
        "required": ["id", "name", "officialCode"],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "Code de province utilisé dans les chemins (34 = İstanbul)"
          },
          "name": { "type": "string" },
          "officialCode": { "type": "string", "example": "TR-34" }
        }
      },
      "NeighborhoodFeatureCollection": {
        "type": "object",
        "required": ["type", "features"],
        "properties": {
          "type": { "type": "string", "const": "FeatureCollection" },
          "features": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/NeighborhoodFeature" }
          }
        }
      },
      "NeighborhoodFeature": {
        "type": "object",
        "required": ["type", "geometry", "properties"],
        "properties": {
          "type": { "type": "string", "const": "Feature" },
          "geometry": { "$ref": "#/components/schemas/GeoJsonGeometry" },
          "properties": { "$ref": "#/components/schemas/NeighborhoodFeatureProperties" }
        }
      },
      "NeighborhoodFeatureProperties": {
        "type": "object",
        "required": ["id", "name", "districtId", "districtName"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "districtId": { "type": "integer", "format": "int64" },
          "districtName": { "type": "string" }
        }
      },
      "GeoJsonGeometry": {
        "type": "object",
        "description": "Géométrie GeoJSON en WGS 84 (EPSG:4326)",
        "required": ["type", "coordinates"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["Point", "Polygon", "MultiPolygon"]
          },
          "coordinates": { "type": "array" }
        }
      },
      "NeighborhoodDetail": {
        "type": "object",
        "required": ["id", "name", "level", "district", "province", "geometry", "centroid"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "level": { "type": "string", "const": "neighborhood" },
          "district": { "$ref": "#/components/schemas/AdminAreaReference" },
          "province": { "$ref": "#/components/schemas/AdminAreaReference" },
          "geometry": { "$ref": "#/components/schemas/GeoJsonGeometry" },
          "centroid": { "$ref": "#/components/schemas/GeoJsonGeometry" }
        }
      },
      "AdminAreaReference": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" }
        }
      },
      "MetricsResponse": {
        "type": "object",
        "required": ["metrics"],
        "properties": {
          "metrics": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MetricDefinition" }
          }
        }
      },
      "MetricDefinition": {
        "type": "object",
        "required": [
          "key",
          "category",
          "unit",
          "nativeLevel",
          "polarity",
          "normalization",
          "displayPrecision",
          "translations",
          "source",
          "observedAt"
        ],
        "properties": {
          "key": { "type": "string" },
          "category": { "type": "string" },
          "unit": { "type": "string" },
          "nativeLevel": {
            "type": "string",
            "enum": ["province", "district", "neighborhood"]
          },
          "polarity": {
            "type": "string",
            "enum": ["higher_is_better", "lower_is_better", "neutral"]
          },
          "normalization": { "$ref": "#/components/schemas/MetricNormalization" },
          "displayPrecision": { "type": "integer", "minimum": 0 },
          "translations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MetricTranslation" }
          },
          "source": { "$ref": "#/components/schemas/MetricSource" },
          "observedAt": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Date de la dernière observation disponible, null si la métrique n'a aucune valeur"
          }
        }
      },
      "MetricNormalization": {
        "type": "object",
        "required": ["method", "version"],
        "properties": {
          "method": { "type": "string" },
          "version": { "type": "string" }
        }
      },
      "MetricTranslation": {
        "type": "object",
        "required": ["locale", "name", "description", "subject"],
        "properties": {
          "locale": { "type": "string", "enum": ["fr", "en", "tr"] },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "subject": { "type": "string" }
        }
      },
      "MetricSource": {
        "type": "object",
        "required": [
          "id",
          "name",
          "organization",
          "url",
          "license",
          "attribution",
          "methodology",
          "retrievedAt",
          "version"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "organization": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "license": { "type": "string" },
          "attribution": { "type": "string" },
          "methodology": { "type": "string" },
          "retrievedAt": { "type": "string", "format": "date" },
          "version": { "type": "string" }
        }
      },
      "MetricValues": {
        "type": "object",
        "description": "Clé = metricKey ; valeur = objet dont les clés sont les identifiants de quartier. Une métrique demandée sans valeur renvoie un objet vide.",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/components/schemas/MetricValue" }
        }
      },
      "MetricValue": {
        "type": "object",
        "required": ["raw", "normalized", "qualityFlag"],
        "properties": {
          "raw": {
            "type": "number",
            "description": "Valeur brute dans l'unité de la métrique, sans arrondi d'affichage"
          },
          "normalized": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Valeur normalisée (0..1) utilisée par le score"
          },
          "qualityFlag": {
            "type": "string",
            "enum": ["ok", "estimated", "stale", "low_coverage", "inherited"],
            "description": "Qualité de la valeur ; inherited signifie que la valeur vient du district parent"
          }
        }
      },
      "NeighborhoodMetrics": {
        "type": "object",
        "required": ["neighborhoodId", "metrics"],
        "properties": {
          "neighborhoodId": { "type": "integer", "format": "int64" },
          "metrics": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/NeighborhoodMetric" }
          }
        }
      },
      "NeighborhoodMetric": {
        "type": "object",
        "required": [
          "key",
          "raw",
          "normalized",
          "qualityFlag",
          "observedAt",
          "referencePeriod",
          "source"
        ],
        "properties": {
          "key": { "type": "string" },
          "raw": {
            "type": "number",
            "description": "Valeur brute dans l'unité de la métrique, sans arrondi d'affichage"
          },
          "normalized": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Valeur normalisée (0..1) utilisée par le score"
          },
          "qualityFlag": {
            "type": "string",
            "enum": ["ok", "estimated", "stale", "low_coverage", "inherited"],
            "description": "Qualité de la valeur ; inherited signifie que la valeur vient du district parent"
          },
          "observedAt": { "type": "string", "format": "date" },
          "referencePeriod": { "type": "string" },
          "source": { "$ref": "#/components/schemas/NeighborhoodMetricSource" }
        }
      },
      "NeighborhoodMetricSource": {
        "type": "object",
        "required": ["id", "name", "organization", "license", "attribution"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "organization": { "type": "string" },
          "license": { "type": "string" },
          "attribution": { "type": "string" }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "code": {
            "type": "string",
            "description": "Code stable : metrics_required, unknown_metric, city_not_found, neighborhood_not_found, database_unavailable, internal_error"
          }
        }
      }
    }
  }
}
