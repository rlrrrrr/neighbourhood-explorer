{
  "openapi": "3.1.0",
  "info": {
    "title": "Neighbourhood Explorer API",
    "version": "1.0.0",
    "description": "Versioned API contract (source of truth). The frontend generates its types from this file."
  },
  "servers": [
    { "url": "http://localhost:5080", "description": "Local API (dotnet run)" },
    { "url": "http://localhost:5080", "description": "Containerized API (Docker Compose, host port 5080)" }
  ],
  "paths": {
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "getAuthCsrfToken",
        "summary": "Anti-forgery token for authenticated writes",
        "responses": {
          "200": {
            "description": "Token to send back in the X-CSRF-TOKEN header; the companion cookie is set by the server",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CsrfResponse" }
              }
            }
          },
          "429": {
            "description": "Authentication rate limit reached",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "registerAccount",
        "summary": "Create an account and send the confirmation email",
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Account created (or still unconfirmed); the confirmation email has been sent",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RegisterResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid input or rejected anti-forgery token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "429": {
            "description": "Authentication rate limit reached",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/confirm-email": {
      "post": {
        "operationId": "confirmEmailAddress",
        "summary": "Confirm an account email address with the token from the confirmation link",
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConfirmEmailRequest" }
            }
          }
        },
        "responses": {
          "204": { "description": "Email address confirmed" },
          "400": {
            "description": "Invalid or expired token, or rejected anti-forgery token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "429": {
            "description": "Authentication rate limit reached",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Sign in and start the session cookie",
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated account profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MeResponse" }
              }
            }
          },
          "400": {
            "description": "Rejected anti-forgery token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "403": {
            "description": "Email address not confirmed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "423": {
            "description": "Account temporarily locked after too many attempts",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "429": {
            "description": "Authentication rate limit reached",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "End the session",
        "security": [{ "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "responses": {
          "204": { "description": "Signed out" },
          "400": {
            "description": "Rejected anti-forgery token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "getCurrentAccount",
        "summary": "Authenticated account profile",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Authenticated account profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MeResponse" }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/favorites": {
      "get": {
        "operationId": "listFavorites",
        "summary": "Authenticated account favorites, from newest to oldest",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Authenticated account favorites, from newest to oldest",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FavoritesResponse" }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/favorites/{targetType}/{targetId}": {
      "put": {
        "operationId": "putFavorite",
        "summary": "Save a favorite (idempotent)",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "targetType",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "enum": ["neighborhood"] }
          },
          {
            "name": "targetId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          { "$ref": "#/components/parameters/CsrfToken" }
        ],
        "responses": {
          "204": { "description": "Favorite saved" },
          "400": {
            "description": "Unknown favorite target or rejected anti-forgery token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteFavorite",
        "summary": "Remove a favorite (idempotent)",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "targetType",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "enum": ["neighborhood"] }
          },
          {
            "name": "targetId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          { "$ref": "#/components/parameters/CsrfToken" }
        ],
        "responses": {
          "204": { "description": "Favorite removed" },
          "400": {
            "description": "Rejected anti-forgery token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/users": {
      "get": {
        "operationId": "listAdminUsers",
        "summary": "Accounts known to the service (administrators only)",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of accounts returned (default 100, maximum 200)",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          }
        ],
        "responses": {
          "200": {
            "description": "Accounts sorted from newest to oldest",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminUsersResponse" }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "403": {
            "description": "Signed in without the admin role",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/users/{userId}": {
      "delete": {
        "operationId": "deleteAdminUser",
        "summary": "Remove an account and its profile and favorites (administrators only)",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          { "$ref": "#/components/parameters/CsrfToken" }
        ],
        "responses": {
          "204": { "description": "Account removed" },
          "400": {
            "description": "Rejected anti-forgery token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "403": {
            "description": "Signed in without the admin role",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "404": {
            "description": "No account with this identifier",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "409": {
            "description": "An administrator cannot remove their own account",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/cities": {
      "get": {
        "operationId": "getCities",
        "summary": "Villes disponibles",
        "responses": {
          "200": {
            "description": "Available provinces, sorted by official code",
            "headers": {
              "ETag": {
                "description": "Content fingerprint, usable with If-None-Match",
                "schema": { "type": "string" }
              },
              "Cache-Control": {
                "description": "Client-side cache duration",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CitiesResponse" }
              }
            }
          },
          "503": {
            "description": "Database is not configured or cannot be reached",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    },
    "/api/v1/cities/{cityId}/neighborhoods": {
      "get": {
        "operationId": "getCityNeighborhoods",
        "summary": "Simplified geometries of a city's neighborhoods (GeoJSON)",
        "parameters": [
          {
            "name": "cityId",
            "in": "path",
            "required": true,
            "description": "Province plate code (1 to 81; 34 = Istanbul), resolved through official_code = TR-{cityId}",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 81
            }
          }
        ],
        "responses": {
          "200": {
            "description": "GeoJSON FeatureCollection; each geometry is simplified for display (COALESCE(display_geometry, geometry))",
            "headers": {
              "ETag": {
                "description": "Content fingerprint, usable with If-None-Match",
                "schema": { "type": "string" }
              },
              "Cache-Control": {
                "description": "Client-side cache duration",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/geo+json": {
                "schema": { "$ref": "#/components/schemas/NeighborhoodFeatureCollection" }
              }
            }
          },
          "404": {
            "description": "Unknown city",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "503": {
            "description": "Database is not configured or cannot be reached",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    },
    "/api/v1/neighborhoods/{id}": {
      "get": {
        "operationId": "getNeighborhood",
        "summary": "Neighborhood details: hierarchy, complete geometry, and centroid",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Internal neighborhood identifier (admin_area.id)",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Neighborhood found",
            "headers": {
              "ETag": {
                "description": "Content fingerprint, usable with If-None-Match",
                "schema": { "type": "string" }
              },
              "Cache-Control": {
                "description": "Client-side cache duration",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NeighborhoodDetail" }
              }
            }
          },
          "404": {
            "description": "Quartier inconnu",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "503": {
            "description": "Database is not configured or cannot be reached",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    },
    "/api/v1/neighborhoods/{id}/metrics": {
      "get": {
        "operationId": "getNeighborhoodMetrics",
        "summary": "All metrics for a neighborhood, with their observation date and source",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Internal neighborhood identifier (admin_area.id)",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Most recent values for the neighborhood, sorted by metric key",
            "headers": {
              "ETag": {
                "description": "Content fingerprint, usable with If-None-Match",
                "schema": { "type": "string" }
              },
              "Cache-Control": {
                "description": "Client-side cache duration",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NeighborhoodMetrics" }
              }
            }
          },
          "404": {
            "description": "Unknown neighborhood",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "503": {
            "description": "Database is not configured or cannot be reached",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Service health: database, data version, and AI status",
        "responses": {
          "200": {
            "description": "Current service status",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/metrics": {
      "get": {
        "operationId": "getMetrics",
        "summary": "Metric definitions with their source, translations, and latest observation date",
        "responses": {
          "200": {
            "description": "Available metric definitions",
            "headers": {
              "ETag": {
                "description": "Content fingerprint, usable with If-None-Match",
                "schema": { "type": "string" }
              },
              "Cache-Control": {
                "description": "Client-side cache duration",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MetricsResponse" }
              }
            }
          },
          "503": {
            "description": "Database is not configured or cannot be reached",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    },
    "/api/v1/cities/{cityId}/metric-values": {
      "get": {
        "operationId": "getCityMetricValues",
        "summary": "Latest values of the requested metrics for a city's neighborhoods",
        "parameters": [
          {
            "name": "cityId",
            "in": "path",
            "required": true,
            "description": "Province plate code (1 to 81; 34 = Istanbul), resolved through official_code = TR-{cityId}",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 81
            }
          },
          {
            "name": "metrics",
            "in": "query",
            "required": true,
            "description": "Metric keys separated by commas (e.g. population_density)",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Raw and normalized values, indexed first by metric key and then by neighborhood ID",
            "headers": {
              "ETag": {
                "description": "Content fingerprint, usable with If-None-Match",
                "schema": { "type": "string" }
              },
              "Cache-Control": {
                "description": "Client-side cache duration",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MetricValues" }
              }
            }
          },
          "400": {
            "description": "Missing metrics parameter or unknown metric key",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "404": {
            "description": "Unknown city",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "503": {
            "description": "Database is not configured or cannot be reached",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "CsrfToken": {
        "name": "X-CSRF-TOKEN",
        "in": "header",
        "required": true,
        "description": "Token returned by GET /api/v1/auth/csrf, required for every authenticated write",
        "schema": { "type": "string" }
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ne.session",
        "description": "Identity session cookie set by POST /api/v1/auth/login"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["database", "ai"],
        "properties": {
          "database": {
            "type": "string",
            "enum": ["ok", "unavailable"],
            "description": "PostgreSQL/PostGIS database status"
          },
          "dataVersion": {
            "type": ["string", "null"],
            "description": "Version of the data loaded by the ETL, null until data is loaded"
          },
          "ai": {
            "type": "string",
            "enum": ["disabled", "warming", "ready", "unavailable"],
            "description": "Decision model status (disabled when AI_ENABLED is disabled)"
          }
        }
      },
      "CitiesResponse": {
        "type": "object",
        "required": ["cities"],
        "properties": {
          "cities": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/City" }
          }
        }
      },
      "City": {
        "type": "object",
        "required": ["plateCode", "name", "officialCode"],
        "properties": {
          "plateCode": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 81,
            "description": "Province plate code used in paths (34 = Istanbul)"
          },
          "name": { "type": "string" },
          "officialCode": { "type": "string", "example": "TR-34" }
        }
      },
      "NeighborhoodFeatureCollection": {
        "type": "object",
        "required": ["type", "features"],
        "properties": {
          "type": { "type": "string", "const": "FeatureCollection" },
          "features": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/NeighborhoodFeature" }
          }
        }
      },
      "NeighborhoodFeature": {
        "type": "object",
        "required": ["type", "geometry", "properties"],
        "properties": {
          "type": { "type": "string", "const": "Feature" },
          "geometry": { "$ref": "#/components/schemas/GeoJsonGeometry" },
          "properties": { "$ref": "#/components/schemas/NeighborhoodFeatureProperties" }
        }
      },
      "NeighborhoodFeatureProperties": {
        "type": "object",
        "required": ["id", "name", "districtId", "districtName"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "districtId": { "type": "integer", "format": "int64" },
          "districtName": { "type": "string" }
        }
      },
      "GeoJsonGeometry": {
        "type": "object",
        "description": "GeoJSON geometry in WGS 84 (EPSG:4326)",
        "required": ["type", "coordinates"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["Point", "Polygon", "MultiPolygon"]
          },
          "coordinates": { "type": "array" }
        }
      },
      "NeighborhoodDetail": {
        "type": "object",
        "required": ["id", "name", "level", "district", "province", "geometry", "centroid"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "level": { "type": "string", "const": "neighborhood" },
          "district": { "$ref": "#/components/schemas/AdminAreaReference" },
          "province": { "$ref": "#/components/schemas/AdminAreaReference" },
          "geometry": { "$ref": "#/components/schemas/GeoJsonGeometry" },
          "centroid": { "$ref": "#/components/schemas/GeoJsonGeometry" }
        }
      },
      "AdminAreaReference": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" }
        }
      },
      "MetricsResponse": {
        "type": "object",
        "required": ["metrics"],
        "properties": {
          "metrics": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MetricDefinition" }
          }
        }
      },
      "MetricDefinition": {
        "type": "object",
        "required": [
          "key",
          "category",
          "unit",
          "nativeLevel",
          "polarity",
          "normalization",
          "displayPrecision",
          "translations",
          "source",
          "observedAt"
        ],
        "properties": {
          "key": { "type": "string" },
          "category": { "type": "string" },
          "unit": { "type": "string" },
          "nativeLevel": {
            "type": "string",
            "enum": ["province", "district", "neighborhood"]
          },
          "polarity": {
            "type": "string",
            "enum": ["higher_is_better", "lower_is_better", "neutral"]
          },
          "normalization": { "$ref": "#/components/schemas/MetricNormalization" },
          "displayPrecision": { "type": "integer", "minimum": 0 },
          "translations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MetricTranslation" }
          },
          "source": { "$ref": "#/components/schemas/MetricSource" },
          "observedAt": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Date of the latest available observation, null if the metric has no value"
          }
        }
      },
      "MetricNormalization": {
        "type": "object",
        "required": ["method", "version"],
        "properties": {
          "method": { "type": "string" },
          "version": { "type": "string" }
        }
      },
      "MetricTranslation": {
        "type": "object",
        "required": ["locale", "name", "description", "subject"],
        "properties": {
          "locale": { "type": "string", "enum": ["fr", "en", "tr"] },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "subject": { "type": "string" }
        }
      },
      "MetricSource": {
        "type": "object",
        "required": [
          "id",
          "name",
          "organization",
          "url",
          "license",
          "attribution",
          "methodology",
          "retrievedAt",
          "version"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "organization": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "license": { "type": "string" },
          "attribution": { "type": "string" },
          "methodology": { "type": "string" },
          "retrievedAt": { "type": "string", "format": "date" },
          "version": { "type": "string" }
        }
      },
      "MetricValues": {
        "type": "object",
        "description": "Key = metricKey; value = object whose keys are neighborhood IDs. A requested metric without a value returns an empty object.",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/components/schemas/MetricValue" }
        }
      },
      "MetricValue": {
        "type": "object",
        "required": ["raw", "normalized", "qualityFlag"],
        "properties": {
          "raw": {
            "type": "number",
            "description": "Raw value in the metric's unit, without display rounding"
          },
          "normalized": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Normalized value (0..1) used by the score"
          },
          "qualityFlag": {
            "type": "string",
            "enum": ["ok", "estimated", "stale", "low_coverage", "inherited"],
            "description": "Value quality; inherited means the value comes from the parent district"
          }
        }
      },
      "NeighborhoodMetrics": {
        "type": "object",
        "required": ["neighborhoodId", "metrics"],
        "properties": {
          "neighborhoodId": { "type": "integer", "format": "int64" },
          "metrics": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/NeighborhoodMetric" }
          }
        }
      },
      "NeighborhoodMetric": {
        "type": "object",
        "required": [
          "key",
          "raw",
          "normalized",
          "qualityFlag",
          "observedAt",
          "referencePeriod",
          "source"
        ],
        "properties": {
          "key": { "type": "string" },
          "raw": {
            "type": "number",
            "description": "Raw value in the metric's unit, without display rounding"
          },
          "normalized": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Normalized value (0..1) used by the score"
          },
          "qualityFlag": {
            "type": "string",
            "enum": ["ok", "estimated", "stale", "low_coverage", "inherited"],
            "description": "Value quality; inherited means the value comes from the parent district"
          },
          "observedAt": { "type": "string", "format": "date" },
          "referencePeriod": { "type": "string" },
          "source": { "$ref": "#/components/schemas/NeighborhoodMetricSource" }
        }
      },
      "NeighborhoodMetricSource": {
        "type": "object",
        "required": ["id", "name", "organization", "license", "attribution"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "organization": { "type": "string" },
          "license": { "type": "string" },
          "attribution": { "type": "string" }
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["code", "errors"],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable error code: validation_failed, invalid_credentials, email_not_confirmed, account_locked, not_authenticated, invalid_token, favorite_target_unknown, csrf_failed, rate_limited"
          },
          "errors": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "CsrfResponse": {
        "type": "object",
        "required": ["token"],
        "properties": {
          "token": { "type": "string" }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["email", "displayName", "password", "locale"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 256 },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
          "password": { "type": "string", "minLength": 12, "maxLength": 256 },
          "locale": {
            "type": ["string", "null"],
            "enum": ["fr", "en", "tr", "ar", null],
            "description": "Preferred email language; the API defaults to fr when unknown"
          }
        }
      },
      "RegisterResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "const": "confirmation_sent" }
        }
      },
      "ConfirmEmailRequest": {
        "type": "object",
        "required": ["userId", "token"],
        "properties": {
          "userId": { "type": "string" },
          "token": { "type": "string" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "MeResponse": {
        "type": "object",
        "required": ["userId", "email", "displayName", "locale", "isDemo", "isAdmin"],
        "properties": {
          "userId": { "type": "string" },
          "email": { "type": "string" },
          "displayName": { "type": "string" },
          "locale": { "type": "string" },
          "isDemo": { "type": "boolean" },
          "isAdmin": { "type": "boolean" }
        }
      },
      "FavoriteResponse": {
        "type": "object",
        "required": ["targetType", "targetId", "createdAt"],
        "properties": {
          "targetType": { "type": "string", "const": "neighborhood" },
          "targetId": { "type": "string" },
          "name": { "type": ["string", "null"] },
          "district": { "type": ["string", "null"] },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "FavoritesResponse": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FavoriteResponse" }
          }
        }
      },
      "AdminUserResponse": {
        "type": "object",
        "required": ["userId", "email", "displayName", "createdAt", "emailConfirmed", "isDemo", "isAdmin"],
        "properties": {
          "userId": { "type": "string" },
          "email": { "type": "string" },
          "displayName": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "emailConfirmed": { "type": "boolean" },
          "isDemo": { "type": "boolean" },
          "isAdmin": { "type": "boolean" }
        }
      },
      "AdminUsersResponse": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AdminUserResponse" }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "code": {
            "type": "string",
            "description": "Code stable : metrics_required, unknown_metric, city_not_found, neighborhood_not_found, database_unavailable, internal_error"
          }
        }
      }
    }
  }
}
